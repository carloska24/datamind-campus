# Alternativa ao botão "Salvar chave neste computador".
# Copie para .env, preencha somente os provedores desejados e reinicie o servidor.
# Nunca use o prefixo VITE_ para essas chaves.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Em produção: URL HTTPS, disco persistente e código privado de ativação.
# Render define RENDER_EXTERNAL_URL automaticamente; PUBLIC_URL é opcional ali.
# NODE_ENV=production
# PUBLIC_URL=https://seu-campus.onrender.com
# DATA_DIR=/var/data
# SETUP_TOKEN=gere-um-codigo-aleatorio-de-pelo-menos-32-caracteres
